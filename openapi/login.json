{
  "openapi": "3.1.0",
  "info": {
    "title": "Cheladb login API",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/auth/v1/auth-request": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Looks up a pending sign-in and reports whether sign-up is offered. Sets no cookie.",
        "operationId": "getAuthRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The pending sign-in is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthRequestInfo"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "This sign-in has expired or is unknown: `sign_in_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Zitadel is unavailable: `unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/logout": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Ends the session and clears the HttpOnly session and step cookies.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/password-reset": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Emails a password-reset link if the account exists. Always answers the same, whether or not it does.",
        "operationId": "requestPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/password-reset/confirm": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Sets a new password with the code from the reset email.",
        "operationId": "confirmPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed (`invalid_request`), the password is too weak (`weak_password`) or the code is wrong (`invalid_code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Zitadel is unavailable: `unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/resend-code": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Sends the verification code again. Reads the HttpOnly step cookie. Always answers the same, whether or not a code was sent.",
        "operationId": "resendCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/sign-in": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Signs in with email and password. On success sets the HttpOnly session cookie, or, when the email still needs verifying, the HttpOnly step cookie that the code step reads.",
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in (`done`, with the session cookie set and the step cookie cleared) or waiting for the email code (`verify`, with the step cookie set)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextStep"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password: `invalid_credentials`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "This sign-in has expired or is unknown: `sign_in_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Zitadel is unavailable: `unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/sign-up": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Creates an account. Sets the HttpOnly session cookie when email verification is off, otherwise the HttpOnly step cookie that the code step reads.",
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in (`done`, with the session cookie set and the step cookie cleared) or waiting for the email code (`verify`, with the step cookie set)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextStep"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed (`invalid_request`) or the password is too weak (`weak_password`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email exists (`email_taken`); only when email verification is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "This sign-in has expired or is unknown: `sign_in_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Zitadel is unavailable: `unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/verify-email": {
      "post": {
        "tags": [
          "login"
        ],
        "description": "Checks the emailed code. Reads the HttpOnly step cookie; on success sets the HttpOnly session cookie and clears the step cookie.",
        "operationId": "verifyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Email verified and signed in: `next` is `done`, the session cookie is set and the step cookie cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed (`invalid_request`) or the code is wrong (`invalid_code`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "This sign-in has expired or is unknown: `sign_in_expired`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 8 KiB: `too_large`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "The body is not JSON (wrong content type): `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "The body is JSON but has the wrong fields: `invalid_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts: `rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Zitadel is unavailable: `unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthRequestBody": {
        "type": "object",
        "required": [
          "authRequest"
        ],
        "properties": {
          "authRequest": {
            "type": "string"
          }
        }
      },
      "AuthRequestInfo": {
        "type": "object",
        "description": "Whether the pending sign-in's instance allows sign-up.",
        "required": [
          "signUp"
        ],
        "properties": {
          "signUp": {
            "type": "boolean"
          }
        }
      },
      "CodeBody": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "ConfirmBody": {
        "type": "object",
        "required": [
          "userId",
          "code",
          "password"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        }
      },
      "DoneTag": {
        "type": "string",
        "enum": [
          "done"
        ]
      },
      "EmailBody": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "EmptyRequest": {
        "type": "object"
      },
      "EmptyResponse": {
        "type": "object",
        "description": "An empty JSON object."
      },
      "ErrorBody": {
        "type": "object",
        "description": "The documented shape of the `error` object. Some codes add extra keys (for example\n`keys`), which are documented per code.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, machine-readable error code. Serialises as snake_case.",
        "enum": [
          "unauthorized",
          "forbidden",
          "tenant_not_bound",
          "not_found",
          "method_not_allowed",
          "invalid_request",
          "too_large",
          "rate_limited",
          "unavailable",
          "timeout",
          "internal",
          "database_not_ready",
          "branch_not_ready",
          "credentials_unavailable",
          "backup_branch",
          "has_children",
          "branch_cap_reached",
          "main_branch",
          "name_taken",
          "already_deleting",
          "public_key_exists",
          "public_key_not_revocable",
          "role_refused",
          "not_applied",
          "worker_unavailable",
          "invalid_credentials",
          "email_taken",
          "invalid_code",
          "weak_password",
          "sign_in_expired"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "The schema error responses reference: `{\"error\": ErrorBody}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "NextStep": {
        "oneOf": [
          {
            "type": "object",
            "description": "Signed in: send the browser to `redirect` (Zitadel's callback for the pending sign-in).",
            "required": [
              "redirect",
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "enum": [
                  "done"
                ]
              },
              "redirect": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "description": "The email isn't verified: show the code step.",
            "required": [
              "next"
            ],
            "properties": {
              "next": {
                "type": "string",
                "enum": [
                  "verify"
                ]
              }
            }
          }
        ],
        "description": "What the sign-in pages do next, as `{\"next\": \"done\", \"redirect\": …}` or `{\"next\": \"verify\"}`."
      },
      "SignInBody": {
        "type": "object",
        "required": [
          "authRequest",
          "email",
          "password"
        ],
        "properties": {
          "authRequest": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignUpBody": {
        "type": "object",
        "required": [
          "authRequest",
          "email",
          "password",
          "givenName",
          "familyName"
        ],
        "properties": {
          "authRequest": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "familyName": {
            "type": "string"
          },
          "givenName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignedIn": {
        "type": "object",
        "description": "The signed-in answer: `next` is always `done`.",
        "required": [
          "next",
          "redirect"
        ],
        "properties": {
          "next": {
            "$ref": "#/components/schemas/DoneTag"
          },
          "redirect": {
            "type": "string"
          }
        }
      }
    }
  }
}
