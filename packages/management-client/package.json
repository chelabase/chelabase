{
  "name": "@cheladb/management-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Cheladb Management API (orval-generated TanStack Query hooks over a fetch mutator)",
  "type": "module",
  "main": "./src/index.ts",
