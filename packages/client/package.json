{
  "name": "@chelabase/client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Chelabase data API, built on fetch with no runtime dependencies",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": {
      "edge-light": "./src/server.ts",
      "workerd": "./src/server.ts",
      "node": "./src/server.ts",
      "browser": "./src/server-browser.ts",
      "default": "./src/server.ts"
    },
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
