{
  "openapi": "3.1.0",
  "info": {
    "title": "Chelabase identity (internal)",
    "version": "0.1.0",
    "description": "Internal identity service. Callers are auth, orchestrator, worker and bootstrap (chelabase-init's bootstrap), each with its own bearer token; each route is limited to the callers listed in x-callers, and on a pool route to the kinds of pool x-caller-pools lists for each (`members`, or `app` for any `app-<uuid>` pool); anything else answers 403. A pool is `members` or `app-<lowercase uuid>`."
  },
  "servers": [
    {
      "url": "http://identity:8080"
    }
  ],
  "security": [
    {
      "caller": []
    }
  ],
  "paths": {
    "/internal/v1/pools/{pool}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Pool"
        }
      ],
      "post": {
        "operationId": "createPool",
        "summary": "Create a pool's schema and run its migrations. Idempotent.",
        "x-callers": [
          "bootstrap",
          "worker"
        ],
        "x-caller-pools": {
          "bootstrap": [
            "members"
          ],
          "worker": [
            "app"
          ]
        },
        "responses": {
          "201": {
            "description": "The pool exists and is migrated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pool"
                  ],
                  "properties": {
                    "pool": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "dropPool",
        "summary": "Drop a pool's schema with every user and session in it. Idempotent.",
        "x-callers": [
          "worker"
        ],
        "x-caller-pools": {
          "worker": [
            "app"
          ]
        },
        "responses": {
          "204": {
            "description": "The pool is gone"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "`members` is never dropped: 403 `forbidden` for every caller."
      }
    },
    "/internal/v1/pools/{pool}/users": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Pool"
        }
      ],
      "post": {
        "operationId": "createUser",
        "summary": "Create a user, with or without a password",
        "x-callers": [
          "auth",
          "orchestrator"
        ],
        "x-caller-pools": {
          "auth": [
            "members",
            "app"
          ],
          "orchestrator": [
            "members",
            "app"
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "email_verified": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "operationId": "listUsers",
        "summary": "List users, oldest first, one page at a time",
        "description": "`search` narrows the list to users whose email contains it, ignoring case (`%` and `_` match themselves); `total` counts the matches. `email` instead finds the one user whose address is exactly it, ignoring case: one indexed read returning at most one user (`limit` and `offset` are echoed but not applied). `email` and `search` together are refused.",
        "x-callers": [
          "auth",
          "orchestrator",
          "worker"
        ],
        "x-caller-pools": {
          "auth": [
            "members",
            "app"
          ],
          "orchestrator": [
            "members",
            "app"
          ],
          "worker": [
            "app"
          ]
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 320
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 320
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "users",
                    "total",
                    "limit",
                    "offset"
                  ],
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/internal/v1/pools/{pool}/users/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Pool"
        },
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "operationId": "getUser",
        "summary": "Get a user",
        "x-callers": [
          "auth",
          "orchestrator",
          "worker"
        ],
        "x-caller-pools": {
          "auth": [
            "members",
