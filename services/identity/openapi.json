    "/internal/v1/pools/{pool}/codes": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Pool"
        }
      ],
      "post": {
        "operationId": "createCode",
        "summary": "Issue a six-digit email code for a user, replacing that user's earlier code of the same kind",
        "description": "`delivery: email` sends it with the kind's template to the user's email and never returns it (409 `email_not_configured` without SMTP; 502 `email_send_failed` when the SMTP server refuses). `delivery: return` returns it and sends nothing (link delivery). The orchestrator may create only `invite` codes (403 otherwise). An `invite` code is refused with 409 `invite_refused` for an established account (a password and a verified email); a pre-registered account (no password, or an unverified email) may be invited. A code is bound to the user's email when issued: changing the email kills every outstanding code. TTL: `verify` and `reset` 15 minutes, `invite` 7 days. A code allows 5 wrong guesses; the next guess, right or wrong, is refused.",
        "x-callers": [
          "auth",
          "orchestrator"
        ],
        "x-caller-pools": {
          "auth": [
            "members",
            "app"
          ],
          "orchestrator": [
            "members"
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "kind",
                  "delivery"
                ],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "kind": {
                    "$ref": "#/components/schemas/CodeKind"
                  },
                  "delivery": {
                    "type": "string",
                    "enum": [
                      "email",
                      "return"
                    ]
                  },
                  "project_name": {
                    "type": "string",
                    "maxLength": 128,
                    "description": "Shown in the email; single line. Default `Chelabase`."
                  },
                  "link": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri",
                    "description": "Absolute http(s) URL where the code is entered, shown in the email. Never carries the code."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "kind",
                    "delivery",
                    "expires_at"
                  ],
                  "properties": {
                    "kind": {
                      "$ref": "#/components/schemas/CodeKind"
                    },
                    "delivery": {
                      "type": "string",
                      "enum": [
                        "email",
                        "return"
                      ]
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^[0-9]{6}$",
                      "description": "Only with `delivery: return`."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/internal/v1/pools/{pool}/codes/verify": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Pool"
        }
      ],
      "post": {
        "operationId": "verifyCode",
        "summary": "Check and consume a code",
        "description": "Counts one attempt and consumes the code in one step. Any wrong, expired, used, replaced or locked-out code, a code sent to an address the user no longer has, an unknown user, or an `invite` code for an account that has since been established (a password and a verified email), is 400 `invalid_code`; the last two cost no attempt. `verify` marks the email verified. `reset` and `invite` require `new_password`: they set it (400 `weak_password` before the code is spent if its length is out of range), mark the email verified and revoke all of the user's sessions. Kinds never stand in for each other.",
        "x-callers": [
          "auth"
        ],
        "x-caller-pools": {
          "auth": [
            "members",
            "app"
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "kind",
                  "code"
                ],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "kind": {
                    "$ref": "#/components/schemas/CodeKind"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "new_password": {
                    "type": "string",
                    "maxLength": 1024,
                    "description": "Required for `reset` and `invite`; refused for `verify`."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consumed; the updated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/internal/v1/pools/{pool}/users/{id}/invite-notice": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Pool"
        },
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "post": {
        "operationId": "sendInviteNotice",
        "summary": "Tell an existing account it was invited",
        "description": "Mails the user a notice that links to the invite's ticket. It holds no code and sets nothing: the person accepts by signing in as themselves. Members pool only (400 `invalid_pool`). 409 `email_not_configured` without SMTP; 502 `email_send_failed` when the SMTP server refuses.",
        "x-callers": [
          "orchestrator"
        ],
        "x-caller-pools": {
          "orchestrator": [
            "members"
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "link"
                ],
                "properties": {
                  "project_name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "link": {
                    "type": "string",
                    "maxLength": 2048,
                    "description": "Absolute http(s) URL of the invite's ticket; refused with a `code` parameter"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sent"
                  ],
                  "properties": {
                    "sent": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/internal/v1/email/status": {
      "get": {
        "operationId": "emailStatus",
        "summary": "Whether SMTP is configured and answers (connect, EHLO, TLS and auth as configured)",
        "x-callers": [
          "auth",
          "orchestrator"
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "configured",
                    "reachable"
                  ],
                  "properties": {
                    "configured": {
                      "type": "boolean"
                    },
                    "reachable": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "caller": {
        "type": "http",
        "scheme": "bearer",
        "description": "The caller's token from tokens/{auth,orchestrator,worker}-identity.token"
      }
    },
    "parameters": {
      "Pool": {
        "name": "pool",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^(members|app-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
        }
      },
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "An error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "not_found",
              "invalid_pool",
              "invalid_request",
              "body_too_large",
              "pool_not_found",
              "user_not_found",
              "session_not_found",
              "bad_credentials",
              "banned",
              "conflict",
              "invalid_email",
              "weak_password",
              "bad_request",
              "invalid_code",
              "email_not_configured",
              "invite_refused",
              "email_send_failed",
              "internal"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "email_verified",
          "banned",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "banned": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "expires_at",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CodeKind": {
        "type": "string",
        "enum": [
          "verify",
          "reset",
          "invite"
        ]
      },
      "UserDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/User"
          },
          {
            "type": "object",
            "required": [
              "has_password",
              "ban_reason"
            ],
            "properties": {
              "has_password": {
                "type": "boolean",
                "description": "Whether the user can sign in with a password"
              },
              "ban_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Why the user is banned; null when they aren't"
              }
            }
          }
        ]
      }
    }
  }
}
