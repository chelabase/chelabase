{
  "openapi": "3.1.0",
  "info": {
    "title": "Chelabase identity (internal)",
    "version": "0.1.0",
    "description": "Internal identity service. Callers are auth, orchestrator and worker, each with its own bearer token; each route is limited to the callers listed in x-callers. A pool is `members` or `app-<lowercase uuid>`."
  },
  "servers": [{ "url": "http://identity:8080" }],
  "security": [{ "caller": [] }],
  "paths": {
    "/internal/v1/pools/{pool}": {
      "parameters": [{ "$ref": "#/components/parameters/Pool" }],
      "post": {
        "operationId": "createPool",
        "summary": "Create a pool's schema and run its migrations. Idempotent.",
        "x-callers": ["worker"],
        "responses": {
          "201": {
            "description": "The pool exists and is migrated",
            "content": { "application/json": { "schema": { "type": "object", "required": ["pool"], "properties": { "pool": { "type": "string" } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "dropPool",
        "summary": "Drop a pool's schema with every user and session in it. Idempotent.",
        "x-callers": ["worker"],
        "responses": {
          "204": { "description": "The pool is gone" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/internal/v1/pools/{pool}/users": {
      "parameters": [{ "$ref": "#/components/parameters/Pool" }],
      "post": {
        "operationId": "createUser",
        "summary": "Create a user, with or without a password",
        "x-callers": ["auth", "orchestrator"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "maxLength": 320 },
                  "password": { "type": "string", "maxLength": 1024 },
                  "name": { "type": "string", "maxLength": 256 },
                  "email_verified": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/User" } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/internal/v1/pools/{pool}/sessions": {
      "parameters": [{ "$ref": "#/components/parameters/Pool" }],
      "post": {
        "operationId": "signIn",
        "summary": "Password sign-in: creates a session",
        "x-callers": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": { "email": { "type": "string", "maxLength": 320 }, "password": { "type": "string", "maxLength": 1024 } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["session_id", "session_token", "user"],
                  "properties": {
                    "session_id": { "type": "string" },
                    "session_token": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "description": "`bad_credentials`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "`banned`, or `forbidden` for a caller outside the allow-list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/internal/v1/pools/{pool}/sessions/lookup": {
      "parameters": [{ "$ref": "#/components/parameters/Pool" }],
      "post": {
        "operationId": "getSessionByToken",
        "summary": "Resolve a session token (sent in the body, never the URL)",
        "x-callers": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["token"], "properties": { "token": { "type": "string", "maxLength": 512 } } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The live session and its user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["session", "user"],
                  "properties": { "session": { "$ref": "#/components/schemas/Session" }, "user": { "$ref": "#/components/schemas/User" } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "description": "`session_not_found` or `pool_not_found`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "caller": { "type": "http", "scheme": "bearer", "description": "The caller's token from tokens/{auth,orchestrator,worker}-identity.token" }
    },
    "parameters": {
      "Pool": {
        "name": "pool",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^(members|app-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$" }
      }
    },
    "responses": {
      "Error": { "description": "An error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "enum": ["unauthorized", "forbidden", "not_found", "invalid_pool", "invalid_request", "body_too_large", "pool_not_found", "user_not_found", "session_not_found", "bad_credentials", "banned", "conflict", "invalid_email", "weak_password", "bad_request", "internal"]
          },
          "message": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name", "email_verified", "banned", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "email_verified": { "type": "boolean" },
          "banned": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Session": {
        "type": "object",
        "required": ["id", "user_id", "expires_at", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "user_id": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
