          ],
          "orchestrator": [
            "members",
            "app"
          ],
          "worker": [
            "app"
          ]
        },
        "responses": {
          "200": {
            "description": "The user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/UserDetail"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteUser",
        "summary": "Delete a user with their sessions and accounts",
        "x-callers": [
          "auth",
          "orchestrator"
        ],
        "x-caller-pools": {
          "auth": [
            "members",
            "app"
          ],
          "orchestrator": [
            "members",
            "app"
          ]
        },
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/internal/v1/pools/{pool}/users/{id}/email": {
      "parameters": [
