# Copy to repo root `.env` or export before running apps.
# Do not commit real secrets.
# After `just zitadel-bootstrap`, prefer sourcing `.cheladb/zitadel/demo.env`.
# Compose reads this file (--env-file) for interpolation only.

# --- Worktree slots (scripts/lib/slots.sh; `just stack`) ---
# Every `just` recipe loads the worktree's slot: `just wt-add` gives a worktree slot 1-9 and
# writes its .env.local; the main checkout (and a worktree without one) is slot 0, whose
# values are the ones in this file. Slot N adds 100 × N to every app-tier port:
# CHELADB_SLOT=0                      # the app tier is Compose project cheladb-s<N>
# CHELADB_WORKTREE=<path>             # the worktree's root directory (auto-set by just wt-add)
# CHELADB_COMPOSE_PROJECT=cheladb-s0  # Compose project name (auto-derived from slot)
# CHELADB_METADATA_DB=cheladb_metadata  # slot N: cheladb_metadata_s<N>, same server
# CHELADB_DEV_DIR=.cheladb/dev        # `just dev` pids and logs; slot N: .cheladb/dev/s<N>
# CHELADB_NATS_PORT=4222  CHELADB_NATS_MONITOR_PORT=8222  CHELADB_VALKEY_PORT=6379
# CHELADB_PROXY_PG_PORT=4432  CHELADB_PROXY_HTTP_PORT=4444  CHELADB_STUDIO_PORT=3000
# CHELADB_GATEWAY_PORT=8000  CHELADB_INTERNAL_PORT=8083 (plus the *_ADDR and *_URL below)
# The shared tier (metadata Postgres 5433, Zitadel 8080, Mailpit 8025, storage controller 1234,
# pageserver 9898) keeps its ports; its bind mounts follow CHELADB_SHARED_DIR (the main
# checkout's .cheladb, set by `just`).

# --- Metadata Postgres (control plane) ---
CHELADB_METADATA_DATABASE_URL=postgres://cheladb:cheladb@127.0.0.1:5433/cheladb_metadata

# Seeded by migration (demo / default) — use in POST /v1/databases
# CHELADB_DEMO_TENANT_ID=00000000-0000-4000-8000-000000000001
# CHELADB_DEMO_PROJECT_ID=00000000-0000-4000-8000-000000000002

# --- NATS JetStream ---
CHELADB_NATS_URL=nats://127.0.0.1:4222

# --- Zitadel (local) ---
CHELADB_ZITADEL_ISSUER=http://localhost:8080
CHELADB_ZITADEL_JWKS_URL=http://localhost:8080/oauth/v2/keys
# Set to API app client_id from bootstrap (demo.env). Empty skips aud when token has none.
CHELADB_ZITADEL_AUDIENCES=
# CHELADB_DEMO_TOKEN is not stored — mint with: cargo run -q -p cheladb -- dev token
# Machine key: .cheladb/zitadel/demo-sa.json (from cheladb dev bootstrap)

# --- Service bind addresses ---
CHELADB_ORCHESTRATOR_ADDR=127.0.0.1:8081
CHELADB_WORKER_HEALTH_ADDR=127.0.0.1:8082
CHELADB_GATEWAY_ADDR=127.0.0.1:8000
# CHELADB_INTERNAL_ADDR=127.0.0.1:8083
# CHELADB_AUTH_ADDR=127.0.0.1:8084
# CHELADB_REST_ADDR=127.0.0.1:8085
# CHELADB_REST_INTERNAL_ADDR=127.0.0.1:8086
# CHELADB_VALKEY_URL=redis://127.0.0.1:6379
# CHELADB_CONTROL_PLANE_URI=http://host.docker.internal:8083

# --- Proxy CA file (self-hosted only) ---
# Only the path reported as `ca_file` in the connection reveal; it doesn't change which CA
# the proxy uses.
# CHELADB_PROXY_CA_FILE=.cheladb/neon/proxy-ca.crt

# --- Gateway (front door; all API calls go through :8000) ---
# CHELADB_ORCHESTRATOR_URL=http://127.0.0.1:8081
# Comma-separated hostnames that serve the management, login and data APIs; empty = any host.
# CHELADB_API_HOSTS=
# CHELADB_STUDIO_ORIGINS=http://localhost:3000
# CHELADB_GATEWAY_UPSTREAM_TIMEOUT_SECS=60

# --- Database credentials ---
# CHELADB_SECRETS_KEY (path to the key that encrypts database passwords at rest)
# comes from demo.env, written by `cheladb dev bootstrap`. Never rotate or
# delete that file: stored passwords can't be decrypted without it.
# Self-hosted only (ignored in platform mode): true → new databases' `postgres` owner role
# is a real SUPERUSER. Users can then alter `cloud_admin` or `neon_superuser` and break the
# compute's reconfigure (compute_ctl) and the worker's admin SQL for that database.
# CHELADB_DB_OWNER_SUPERUSER=false
# Read by the orchestrator and the worker.
# Most login roles per branch, the owner not counted (default 50, allowed 0..=500).
# CHELADB_BRANCH_ROLE_CAP=50
# Most databases per branch, the system `postgres` database not counted (default 20,
# allowed 1..=1000).
# CHELADB_BRANCH_DATABASE_CAP=20
# Password strength for passwords set in SQL: "on" or "off" (default "off" in self-hosted
# mode; platform mode always checks).
# CHELADB_PASSWORD_STRENGTH=off

# --- Neon storage and proxy (just deps-up; local dev only) ---
# The storage controller (through the hook relay, which picks the slot) and each slot's proxy
# call that slot's internal listener (127.0.0.1:8083 + 100 × slot on the host) with these
# bearer tokens. Compose and the orchestrator both read them; these are the defaults.
# CHELADB_STORCON_HOOK_TOKEN=cheladb-dev-storcon-hook
# CHELADB_PROXY_API_TOKEN=cheladb-dev-proxy-api
# Storage controller address (default 1234 in scripts; usually not overridden)
# STORCON_URL=http://127.0.0.1:1234
# CHELADB_STORCON_URL=http://127.0.0.1:1234

# --- Mode ---
# self-hosted (default): the dev mode. platform: the hosted cloud (not built yet).
# Services refuse to start on any other value.
CHELADB_MODE=self-hosted
# Email verification on sign-up follows the mode: off in self-hosted (accounts are created
# verified), required in platform. Set true/false to override; codes land in Mailpit locally.
# CHELADB_REQUIRE_EMAIL_VERIFICATION=

# --- Local dev only ---
# Internal identity keypair paths come from demo.env (written by `cheladb dev bootstrap`):
#   CHELADB_INTERNAL_SIGNING_KEY (gateway), CHELADB_INTERNAL_VERIFY_KEY (orchestrator)

# --- Studio ---
VITE_ZITADEL_ISSUER=http://localhost:8080
# Studio URL (slot 0: http://localhost:3000; slot N: http://localhost:3N00)
# CHELADB_STUDIO_URL=http://localhost:3000
# Zitadel OIDC app client ID (from bootstrap for slot 0, or from .cheladb/zitadel/studio-sN.env for slot N)
# VITE_ZITADEL_CLIENT_ID=<client_id>
# API base URL: the gateway, never the orchestrator directly (it requires gateway identity).
VITE_API_URL=http://127.0.0.1:8000
