# Values are plain: no quotes, no inline comments (scripts/lib/entry.sh reads them literally).
# Copy to repo root `.env` or export before running apps.
# Do not commit real secrets.
# After `just zitadel-bootstrap`, prefer sourcing `.chelabase/zitadel/demo.env`.
# Compose reads this file (--env-file) for interpolation only.

# --- Metadata Postgres (control plane) ---
CHELABASE_METADATA_DATABASE_URL=postgres://chelabase:chelabase@127.0.0.1:5433/chelabase_metadata

# Seeded by migration (demo / default) — use in POST /v1/databases
# CHELABASE_DEMO_TENANT_ID=00000000-0000-4000-8000-000000000001
# CHELABASE_DEMO_PROJECT_ID=00000000-0000-4000-8000-000000000002

# --- NATS JetStream ---
CHELABASE_NATS_URL=nats://127.0.0.1:4222

# --- The public entry (host settings) ---
# Everything a browser or client reaches goes through the gateway, by host name. The workbench
# values: *.chelabase.localhost on the gateway's port. Rules (checked at startup): each host is
# different; a port matches only that port, and never the scheme's default (80/443); the issuer
# is derived from the auth host and the scheme, so don't set CHELABASE_ZITADEL_ISSUER.
# http or https (blank or unset = https; the workbench sets http): the scheme of every public URL
# and X-Forwarded-Proto. Session cookies are Secure exactly when it is https (in every mode;
# CHELABASE_AUTH_SECURE_COOKIES overrides). Platform mode requires https.
CHELABASE_PUBLIC_SCHEME=http
# Studio web app. Same registrable domain as the API (SameSite=Strict cookies), not a public suffix
CHELABASE_STUDIO_HOST=studio.chelabase.localhost:8000
# Management API, data API and app-user sign-in. Same registrable domain as Studio
CHELABASE_API_HOST=api.chelabase.localhost:8000
# Zitadel, on its own host (its issuer and redirects are root paths); the issuer comes from it
CHELABASE_AUTH_HOST=auth.chelabase.localhost:8000
# Optional (blank = unset): the docs site
CHELABASE_DOCS_HOST=docs.chelabase.localhost:8000
# Optional (blank = unset): the landing page
CHELABASE_LANDING_HOST=landing.chelabase.localhost:8000
# Optional (blank = unset): Mailpit
CHELABASE_MAIL_HOST=mail.chelabase.localhost:8000
# Where the gateway listens (a list; *.localhost resolves to ::1 on some machines).
CHELABASE_GATEWAY_LISTEN=127.0.0.1:8000,[::1]:8000

# --- Zitadel (local) ---
# Set to API app client_id from bootstrap (demo.env). Empty skips aud when token has none.
CHELABASE_ZITADEL_AUDIENCES=
# CHELABASE_DEMO_TOKEN is not stored — mint with: cargo run -q -p chelabase -- dev token
# Machine key: .chelabase/zitadel/demo-sa.json (from chelabase dev bootstrap)

# --- Service bind addresses ---
CHELABASE_ORCHESTRATOR_ADDR=127.0.0.1:8081
CHELABASE_WORKER_HEALTH_ADDR=127.0.0.1:8082
# CHELABASE_INTERNAL_ADDR=127.0.0.1:8083
# CHELABASE_AUTH_ADDR=127.0.0.1:8084
# CHELABASE_REST_ADDR=127.0.0.1:8085
# CHELABASE_REST_INTERNAL_ADDR=127.0.0.1:8086
# CHELABASE_VALKEY_URL=redis://127.0.0.1:6379
# CHELABASE_CONTROL_PLANE_URI=http://host.docker.internal:8083

# --- Proxy CA file (self-hosted only) ---
# Only the path reported as `ca_file` in the connection reveal; it doesn't change which CA
# the proxy uses.
# CHELABASE_PROXY_CA_FILE=.chelabase/neon/proxy-ca.crt

# --- Gateway (front door; all API calls go through :8000) ---
# CHELABASE_ORCHESTRATOR_URL=http://127.0.0.1:8081
# CHELABASE_GATEWAY_UPSTREAM_TIMEOUT_SECS=60

# --- Database credentials ---
# CHELABASE_SECRETS_KEY (path to the key that encrypts database passwords at rest)
# comes from demo.env, written by `chelabase dev bootstrap`. Never rotate or
# delete that file: stored passwords can't be decrypted without it.
# Self-hosted only (ignored in platform mode): true → new databases' `postgres` owner role
# is a real SUPERUSER. Users can then alter `cloud_admin` or `neon_superuser` and break the
# compute's reconfigure (compute_ctl) and the worker's admin SQL for that database.
# CHELABASE_DB_OWNER_SUPERUSER=false
# Read by the orchestrator and the worker.
# Most login roles per branch, the owner not counted (default 50, allowed 0..=500).
# CHELABASE_BRANCH_ROLE_CAP=50
# Most databases per branch, the system `postgres` database not counted (default 20,
# allowed 1..=1000).
# CHELABASE_BRANCH_DATABASE_CAP=20
# Password strength for passwords set in SQL: "on" or "off" (default "off" in self-hosted
# mode; platform mode always checks).
# CHELABASE_PASSWORD_STRENGTH=off

# --- Neon storage and proxy (just deps-up; local dev only) ---
# The storage controller and proxy call the orchestrator's internal listener with these
# bearer tokens. Compose and the orchestrator both read them; these are the defaults.
# CHELABASE_STORCON_HOOK_TOKEN=chelabase-dev-storcon-hook
# CHELABASE_PROXY_API_TOKEN=chelabase-dev-proxy-api
# Storage controller address (default 1234 in scripts; usually not overridden)
# STORCON_URL=http://127.0.0.1:1234
# CHELABASE_STORCON_URL=http://127.0.0.1:1234
# Safekeeper HTTP API by storage-controller id (`id=url`, comma separated); the worker reads
# each timeline's commit LSN from here. Default: the Compose safekeeper on 127.0.0.1:7676.
# CHELABASE_SAFEKEEPER_HTTP=1=http://127.0.0.1:7676

# --- Mode ---
# self-hosted (default): the dev mode. platform: the hosted cloud (not built yet).
# Services refuse to start on any other value.
CHELABASE_MODE=self-hosted
# Email verification of Studio sign-ups (when a tenant switches open sign-up on) and of app users'
# sign-up follows the mode: off in self-hosted (accounts are created verified), required in platform. Set true/false to override; codes land in Mailpit locally.
# CHELABASE_REQUIRE_EMAIL_VERIFICATION=

# --- Local dev only ---
# Internal identity keypair paths come from demo.env (written by `chelabase dev bootstrap`):
#   CHELABASE_INTERNAL_SIGNING_KEY (gateway), CHELABASE_INTERNAL_VERIFY_KEY (orchestrator)

# --- App users (step 6b; docs site, /docs/using/app-users) ---
# Written to demo.env by `chelabase dev bootstrap` (local dev defaults):
#   CHELABASE_ZITADEL_ADMIN_PAT_FILE=.chelabase/zitadel/admin.pat   orchestrator, worker, auth: org and user admin
#   CHELABASE_APP_JWT_PRIVATE_KEY=.chelabase/auth/app-jwt.key       auth signs app tokens (made once, never overwritten)
#   CHELABASE_APP_JWT_PUBLIC_KEY=.chelabase/auth/app-jwt.pub        the gateway verifies them
#   CHELABASE_APP_AUTH_INTERNAL_TOKEN=chelabase-dev-app-auth        auth → orchestrator internal app routes
#   CHELABASE_APP_SESSIONS_INTERNAL_TOKEN=chelabase-dev-app-sessions   gateway → session liveness
# Written to .chelabase/zitadel/actions.env by bootstrap (sourced by just): the webhook's signing key
#   CHELABASE_ZITADEL_ACTIONS_SIGNING_KEY
# Access token lifetime, seconds (auth; 60..=86400)
# CHELABASE_APP_ACCESS_TTL_SECS=900
# Refresh token sliding lifetime, seconds (orchestrator; at most 90 days)
# CHELABASE_APP_REFRESH_TTL_SECS=2592000
# How often the worker reconciles each enabled project's users, seconds (30..=86400)
# CHELABASE_APP_USERS_RECONCILE_SECS=300
# How often the worker reconciles every branch's member roles, seconds (30..=86400): the
# backstop for reconcile requests lost on NATS or whose retries all failed
# CHELABASE_MEMBER_ROLES_SWEEP_SECS=300
# auth's route to the orchestrator's internal listener
# (auth's invite description and acceptance need these two, plus ZITADEL_ADMIN_PAT_FILE above;
# set them whenever auth runs apart from the orchestrator)
CHELABASE_INTERNAL_URL=http://127.0.0.1:8083
CHELABASE_APP_AUTH_INTERNAL_TOKEN=chelabase-dev-app-auth
# The default bearer above is a public dev value: change it (and CHELABASE_APP_SESSIONS_INTERNAL_TOKEN) in platform mode.
# Platform mode: the Zitadel organization whose members administer the instance (/v1/instance/settings); nobody passes while it is unset.
# CHELABASE_OPERATOR_ORG_ID=
# Worker reconcile removes compute containers with no endpoint row; false logs and keeps them
# (a worker on its own metadata database sharing the machine's Docker with another stack)
# CHELABASE_WORKER_REMOVE_ORPHANS=true

# --- Studio ---
# VITE_ZITADEL_* and VITE_API_URL are written to apps/studio/.env.local by `chelabase dev bootstrap`.
