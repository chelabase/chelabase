# Values are plain: no quotes, no inline comments (scripts/lib/entry.sh reads them literally).
#
# Self-hosted install: `cp .env.example .env && docker compose up -d` in infra/compose. Compose
# reads this file for its settings; no service gets it as an env file (init-secrets mounts it
# only to read the CHELABASE_SEED_* lines). Every setting has a default in docker-compose.yml, so
# the copy runs as it is on one machine, at http://studio.chelabase.localhost:8000. Keep .env
# chmod 600 once it holds a seed or an SMTP setting. Do not commit it.
#
# Workbench: `just workbench up` renders each stack's `.chelabase/stacks/<slug>/env/stack.env`
# from this file plus the per-stack values (hosts and ports, service names, paths, images), and
# the stack's apps read that file. Only the settings below
# that aren't commented out reach it; edit this file to change a workbench default.

# --- The public entry (host settings) ---
# Everything a browser or client reaches goes through the gateway, by host name. Rules (checked
# at startup): each host is different; a port matches only that port, and never the scheme's
# default (80/443); the member tokens' issuer is derived from the auth host and the scheme.
# Hosts are lowercase.
# http or https (blank or unset = https in the services; the compose default is http): the
# scheme of every public URL and X-Forwarded-Proto. Session cookies are Secure exactly when it is
# https (in every mode; CHELABASE_AUTH_SECURE_COOKIES overrides). Platform mode requires https.
# TLS ends in front of the gateway (docs: self-hosting/hosts).
CHELABASE_PUBLIC_SCHEME=http
# Studio web app. Same registrable domain as the API (SameSite=Strict cookies), not a public suffix
CHELABASE_STUDIO_HOST=studio.chelabase.localhost:8000
# Management API, data API and app-user sign-in. Same registrable domain as Studio
CHELABASE_API_HOST=api.chelabase.localhost:8000
# The member tokens' issuer, on its own host (nothing is served there; the issuer comes from it)
CHELABASE_AUTH_HOST=auth.chelabase.localhost:8000
# Optional (blank = unset): the docs site, the landing page and Mailpit (workbench only)
CHELABASE_DOCS_HOST=docs.chelabase.localhost:8000
CHELABASE_LANDING_HOST=landing.chelabase.localhost:8000
CHELABASE_MAIL_HOST=mail.chelabase.localhost:8000
# Where a gateway run on the host listens (a list; *.localhost resolves to ::1 on some machines).
# The compose gateway listens on CHELABASE_PUBLIC_PORT inside its container instead.
CHELABASE_GATEWAY_LISTEN=127.0.0.1:8000,[::1]:8000

# --- Self-hosted install: what Compose can't derive from the hosts ---
# Compose can't split a host into its name and port, so set these to match the three hosts
# whenever you change them (init-secrets checks they match and names the line to fix):
# the names without the port, the public port (the hosts' port, else 80 for http / 443 for
# https) and true for https.
# CHELABASE_STUDIO_HOST_NAME=studio.chelabase.localhost
# CHELABASE_API_HOST_NAME=api.chelabase.localhost
# CHELABASE_AUTH_HOST_NAME=auth.chelabase.localhost
# CHELABASE_PUBLIC_PORT=8000
# CHELABASE_PUBLIC_SECURE=false
# Where the host publishes the gateway: the address (0.0.0.0 for every interface, e.g. behind
# your own TLS proxy on another machine) and the port (default: CHELABASE_PUBLIC_PORT).
# CHELABASE_HTTP_ADDR=127.0.0.1
# CHELABASE_HTTP_PORT=8000
# Reverse proxies in front of the gateway whose X-Forwarded-For (or Forwarded) it believes:
# comma-separated CIDRs or addresses, as the gateway sees the proxy (blank: none; the client is
# the TCP peer). See the hosts page, "Behind a reverse proxy". For a proxy on this machine, run it
# as a container on the stack's default network at a fixed address (a subnet and `ipv4_address`
# in docker-compose.override.yml) and list that one address. Never list a Docker network's
# gateway address: it is what the gateway sees for every connection the host forwards to the
# published port.
# CHELABASE_GATEWAY_TRUSTED_PROXIES=172.29.0.2
# The release images: registry prefix and tag. Each image is pinned by digest in the compose
# file; setting either variable replaces that pin (a tag without a digest is not verified).
# CHELABASE_IMAGE_REPO=ghcr.io/chelabase
# CHELABASE_IMAGE_TAG=
# The pinned images (written by scripts/pin-images.sh, checked by scripts/tests/compose-image-pins.sh):
# BEGIN image pins
# ghcr.io/chelabase/gateway:bb1133a33dcd@sha256:840b1814a72121402e5ec2e2add9e3f3c40f7ea60e397d5c816155d624d99b1b
# ghcr.io/chelabase/orchestrator:bb1133a33dcd@sha256:867abf23de4b6d315b122805b89c53b20515edce32fd3d29ca02a6ea84b21285
# ghcr.io/chelabase/worker:bb1133a33dcd@sha256:6cc2292bc2d34624a12af5c9bf05637bcf3dba2efe0ced0dd0d8917a2582c3b8
# ghcr.io/chelabase/rest:bb1133a33dcd@sha256:2542f08a02be096b045d3001468526817cd80f3c1bb79edd3a024ccd7f4e26cf
# ghcr.io/chelabase/auth:bb1133a33dcd@sha256:01099e50fd017de507269f68438bc6767100d69d3c4ac836c88de94e749d48da
# ghcr.io/chelabase/realtime:bb1133a33dcd@sha256:1137c7c510dc89377c7837a974be6ea7493ad847694fd5758c9dd6170aff97d4
# ghcr.io/chelabase/storage:bb1133a33dcd@sha256:a57cdb4bccf91ca2ce617de6676784343cda2e0666c1eceb948b262b2d90ccf2
# ghcr.io/chelabase/functions:bb1133a33dcd@sha256:e5f662a3cc8d7998cdc93f475c77057dd86289f15760063797c4c3d3fe0d050b
# ghcr.io/chelabase/service-runner:bb1133a33dcd@sha256:f7b0e78f7fbe98d5e6d50ff68c69ff294223c81d07e07193b58f5e11c0f0abcd
# ghcr.io/chelabase/compute-egress:bb1133a33dcd@sha256:fbe30ca725e2887ec758cfa01a2854b3eb00da4dc908307acc145621eafa976c
# ghcr.io/chelabase/init:bb1133a33dcd@sha256:a2fe0de399903c6826f82bbbb1c0ff51d564dfee6e76dea2829cc86c63794c4f
# ghcr.io/chelabase/studio:bb1133a33dcd@sha256:dde816ce1c8e602a47643dbe17babd3d82397980a1b4ec3134e1a77973e1ac58
# ghcr.io/chelabase/identity:bb1133a33dcd@sha256:277f08e2c590f2e618e94aa7342f306002d8664639adc85165695e418e4fc216
# ghcr.io/chelabase/functions-runtime:bb1133a33dcd@sha256:fe0204c5526ff3f8d7c9a7fbf2df369ed65109c04389178933d239153f9a93d6
# END image pins
# The compute-egress image (profile `compute-egress`) has no pin until its first release: build it
# like the storage service's below.
# The storage service's image has no pin until its first release: build it (`just images`, or
# docker-compose.build.yml) and set CHELABASE_IMAGE_REPO and CHELABASE_IMAGE_TAG to what you built.
# The identity service's cache of per-pool Better Auth instances holds this many pools (about
# 300 KiB each).
# CHELABASE_IDENTITY_POOL_CACHE_SIZE=256
# The control network the orchestrator and realtime reach computes on, and their static
# addresses in it (change it when it overlaps a network of the host; computes use the upper /23).
# These replace CHELABASE_CONTROL_SUBNET, CHELABASE_CONTROL_COMPUTE_RANGE,
# CHELABASE_ORCHESTRATOR_CONTROL_IP and CHELABASE_REALTIME_CONTROL_IP, which are no longer read.
# CHELABASE_CONTROL_INTERNAL_SUBNET=10.214.4.0/22
# CHELABASE_CONTROL_INTERNAL_COMPUTE_RANGE=10.214.6.0/23
# CHELABASE_ORCHESTRATOR_CONTROL_INTERNAL_IP=10.214.4.10
# CHELABASE_REALTIME_CONTROL_INTERNAL_IP=10.214.4.12
# The computes' own network (internal): computes take addresses from CHELABASE_COMPUTE_RANGE, the
# lower /23 is for static addresses. Change it when it overlaps a network of the host.
# CHELABASE_COMPUTE_SUBNET=10.214.8.0/22
# CHELABASE_COMPUTE_RANGE=10.214.10.0/23
# Computes have no route off those two networks. To let them reach chosen destinations (a database
# for postgres_fdw or dblink, a publisher to subscribe to), run the egress service with
# `COMPOSE_PROFILES=compute-egress` and list the destinations: comma-separated
# `[alias=]host:port[@listen-port]`, public addresses only (blank: nothing leaves). Computes dial
# the listed name at the entry's listen port (the port, or the `@` one when two entries share a
# port). Its address on the compute network must be in CHELABASE_COMPUTE_SUBNET and outside
# CHELABASE_COMPUTE_RANGE (computes are created with it as their resolver).
# CHELABASE_COMPUTE_EGRESS_ALLOW=
# CHELABASE_COMPUTE_EGRESS_IP=10.214.8.2
# Public addresses the egress service must never dial, whatever a listed name resolves to:
# comma-separated IPv4 addresses or networks (203.0.113.7, 198.51.100.0/24; blank: none). List
# this host's own public addresses here, so a listed name that resolves to them can't reach a
# port the host publishes. It only refuses more; an invalid entry (or IPv6) stops the service at
# start.
# CHELABASE_COMPUTE_EGRESS_DENY=
# Its health port (loopback, default 8080) and the seconds it waits to resolve and connect to a
# destination (1 to 300, default 10); blank: the defaults.
# CHELABASE_COMPUTE_EGRESS_HEALTH_PORT=8080
# CHELABASE_COMPUTE_EGRESS_DIAL_TIMEOUT_SECS=10
# Its memory limit (default 256m).
# CHELABASE_COMPUTE_EGRESS_MEMORY=256m
# Where clients connect to databases: the proxy, at <endpoint>.CHELABASE_PROXY_DOMAIN on
# CHELABASE_PROXY_PORT (Postgres) and CHELABASE_PROXY_HTTP_PORT (SQL over HTTP), published on
# CHELABASE_PROXY_ADDR. Connection details in Studio and the API name the same host and port.
# The proxy routes a connection by that host name (TLS SNI), so every <endpoint>.<domain> must
# reach this machine: the default localtest.me resolves to 127.0.0.1 everywhere, for local use;
# on a server, set a domain whose wildcard record points at it (*.db.example.com) and
# CHELABASE_PROXY_ADDR=0.0.0.0. The certificate (*.<domain>) is issued by the install's own CA;
# clients verify with it: `docker compose cp proxy:/tls/ca.crt proxy-ca.crt`. 5432 is the
# Postgres default; change it when the host runs its own Postgres.
# CHELABASE_PROXY_DOMAIN=localtest.me
# CHELABASE_PROXY_ADDR=127.0.0.1
# CHELABASE_PROXY_PORT=5432
# CHELABASE_PROXY_HTTP_PORT=4444
# The worker and the orchestrator join the Docker socket's group (read from the socket at
# start), so no Docker gid is configured.

# --- Self-hosted install: SMTP (optional) ---
# The identity service's emails (invites, password resets, verification codes).
# Unset: no SMTP. The password is read from a file on the host (never put it here):
# CHELABASE_SMTP_PASSWORD_PATH, mounted into the identity service only.
# The service runs as uid and gid 10001 and refuses a password file that is a symlink or is
# readable or writable by its group or others, so the file must be owned by uid 10001 at mode
# 0600 (`sudo chown 10001 <file> && sudo chmod 600 <file>`).
# A changed setting is applied by the next `docker compose up`; the service reads the password
# once at start, so a changed password file by `docker compose restart identity`.
# CHELABASE_SMTP_TLS is how the identity service secures the connection: starttls (required
# STARTTLS, the default), tls (implicit TLS, the default on port 465) or none (plain text, for a
# local relay only).
# CHELABASE_SMTP_HOST=smtp.example.com
# CHELABASE_SMTP_PORT=587
# CHELABASE_SMTP_TLS=starttls
# CHELABASE_SMTP_FROM=chelabase@example.com
# CHELABASE_SMTP_USER=chelabase
# CHELABASE_SMTP_PASSWORD_PATH=/etc/chelabase/smtp.password

# --- Self-hosted install: chosen secret values (optional) ---
# Chosen secret values (optional). chelabase-init writes each one as its secret file on the
# FIRST run only, instead of generating it; they never enter any container's environment.
# Once a file exists, a different value here makes init fail (rotation: chelabase/chelabase#6).
# Values: printable ASCII, no spaces, quotes, backslash, backtick or $; up to 1024 characters;
# passwords and tokens at least 16. Keep this file chmod 600.
# Each seed sets the secret of the same name, except two: CHELABASE_SEED_APP_AUTH_TOKEN is
# CHELABASE_APP_AUTH_INTERNAL_TOKEN, CHELABASE_SEED_APP_SESSIONS_TOKEN is
# CHELABASE_APP_SESSIONS_INTERNAL_TOKEN.
# CHELABASE_SEED_METADATA_DB_PASSWORD=
# CHELABASE_SEED_STORCON_DB_PASSWORD=
# CHELABASE_SEED_S3_ACCESS_KEY=
# CHELABASE_SEED_S3_SECRET_KEY=
# CHELABASE_SEED_NATS_ORCHESTRATOR_PASSWORD=
# CHELABASE_SEED_NATS_WORKER_PASSWORD=
# CHELABASE_SEED_NATS_REALTIME_PASSWORD=
# CHELABASE_SEED_NATS_RUNNER_PASSWORD=
# CHELABASE_SEED_VALKEY_PROXY_PASSWORD=
# CHELABASE_SEED_VALKEY_CONTROL_PASSWORD=
# CHELABASE_SEED_VALKEY_REALTIME_PASSWORD=
# CHELABASE_SEED_VALKEY_RUNNER_PASSWORD=
# CHELABASE_SEED_VALKEY_HEALTH_PASSWORD=
# CHELABASE_SEED_REALTIME_PG_PASSWORD=
# CHELABASE_SEED_REALTIME_INTERNAL_TOKEN=
# CHELABASE_SEED_REST_INTERNAL_TOKEN=
# CHELABASE_SEED_DATA_KEYS_TOKEN=
# CHELABASE_SEED_APP_AUTH_TOKEN=
# CHELABASE_SEED_APP_SESSIONS_TOKEN=
# CHELABASE_SEED_STORAGE_INTERNAL_TOKEN=
# CHELABASE_SEED_NATS_FUNCTIONS_PASSWORD=
# CHELABASE_SEED_ORCHESTRATOR_FUNCTIONS_TOKEN=
# CHELABASE_SEED_WORKER_FUNCTIONS_TOKEN=
# CHELABASE_SEED_FUNCTIONS_SERVICE_RUNNER_TOKEN=
# CHELABASE_SEED_WORKER_SERVICE_RUNNER_TOKEN=
# CHELABASE_SEED_PROXY_API_TOKEN=
# CHELABASE_SEED_STORCON_HOOK_TOKEN=

# --- Mode ---
# self-hosted: what runs today. platform: the hosted cloud (not built yet). Services refuse to
# start on any other value. A self-hosted install always runs self-hosted (docker-compose.yml
# sets it; this line doesn't reach it): only the workbench reads this line.
CHELABASE_MODE=self-hosted
# Email verification of Studio sign-ups (when a tenant switches open sign-up on) and of app users'
# sign-up follows the mode: off in self-hosted (accounts are created verified), required in platform. Set true/false to override; codes land in Mailpit locally.
# CHELABASE_REQUIRE_EMAIL_VERIFICATION=

# --- The workbench's dev member ---
# `just workbench up` signs a dev member up with the stack's setup code; its password is in the
# stack's bootstrap/ dir. A short-lived member token: cargo run -q -p chelabase -- dev token

# --- Settings of a service run on its own (the defaults; Compose sets service-name ones) ---
# CHELABASE_METADATA_DATABASE_URL=postgres://chelabase@127.0.0.1:5433/chelabase_metadata
#   (its password from CHELABASE_METADATA_DATABASE_PASSWORD_FILE)
# CHELABASE_NATS_URL=nats://127.0.0.1:4222
# The management API: comma-separated host:port entries, each resolved at start (Compose names
# its default-network alias and loopback).
# CHELABASE_ORCHESTRATOR_ADDR=127.0.0.1:8081
# CHELABASE_WORKER_HEALTH_ADDR=127.0.0.1:8082
# CHELABASE_INTERNAL_ADDR=127.0.0.1:8083
# CHELABASE_INTERNAL_URL=http://127.0.0.1:8083
# CHELABASE_AUTH_ADDR=127.0.0.1:8084
# CHELABASE_REST_ADDR=127.0.0.1:8085
# CHELABASE_REST_INTERNAL_ADDR=127.0.0.1:8086
# Realtime: its public listener (behind the gateway) and its internal one (/health only).
# CHELABASE_REALTIME_ADDR=127.0.0.1:8087
# CHELABASE_REALTIME_INTERNAL_ADDR=127.0.0.1:8088
# CHELABASE_VALKEY_URL=redis://127.0.0.1:6379
# Valkey over TLS (rediss://): off in a stack, on in platform mode.
# CHELABASE_VALKEY_TLS=off
# CHELABASE_CONTROL_PLANE_URI=http://host.docker.internal:8083
# The gateway's upstreams.
# CHELABASE_ORCHESTRATOR_URL=http://127.0.0.1:8081
# CHELABASE_REALTIME_URL=http://127.0.0.1:8087
# CHELABASE_FUNCTIONS_URL=http://127.0.0.1:8091
# CHELABASE_GATEWAY_UPSTREAM_TIMEOUT_SECS=60
# Edge functions: the functions service's public listener (behind the gateway), its internal
# listener's runtime side (bundle GETs) and its control side (the orchestrator's uploads, the
# worker's invocations), each a comma-separated list of host:port (names resolved at start); the
# runtime it forwards to; and where the orchestrator and the worker reach the control side. Its two bearers come from
# CHELABASE_ORCHESTRATOR_FUNCTIONS_TOKEN_FILE and CHELABASE_WORKER_FUNCTIONS_TOKEN_FILE (the
# orchestrator and the worker read their own), generated by chelabase-init.
# CHELABASE_FUNCTIONS_ADDR=127.0.0.1:8091
# CHELABASE_FUNCTIONS_INTERNAL_ADDR=127.0.0.1:8092
# CHELABASE_FUNCTIONS_CONTROL_ADDR=127.0.0.1:8093
# CHELABASE_FUNCTIONS_RUNTIME_URL=http://127.0.0.1:8080
# CHELABASE_FUNCTIONS_INTERNAL_URL=http://127.0.0.1:8093

# --- Proxy CA file ---
# Only the file name reported as `ca_file` in the connection details (sslrootcert=<it>); it
# doesn't change which CA the proxy uses. A self-hosted install's default is proxy-ca.crt, the
# file `docker compose cp proxy:/tls/ca.crt proxy-ca.crt` writes; a workbench stack sets
# <stack dir>/neon/proxy-ca.crt; a service run on its own defaults to .chelabase/neon/proxy-ca.crt.
# CHELABASE_PROXY_CA_FILE=proxy-ca.crt

# --- Database credentials ---
# CHELABASE_SECRETS_KEY is the path to the key that encrypts database passwords at rest
# (secrets/secrets.key in the secrets volume; a workbench's keys dir). Never rotate or delete
# it: stored passwords can't be decrypted without it.
# Self-hosted only (ignored in platform mode): true → new databases' `postgres` owner role
# is a real SUPERUSER. Users can then alter `cloud_admin` or `neon_superuser` and break the
# compute's reconfigure (compute_ctl) and the worker's admin SQL for that database.
# CHELABASE_DB_OWNER_SUPERUSER=false
# Read by the orchestrator and the worker.
# Most login roles per branch, the owner not counted (default 50, allowed 0..=500).
# CHELABASE_BRANCH_ROLE_CAP=50
# Most databases per branch, the system `postgres` database not counted (default 20,
# allowed 1..=1000).
# CHELABASE_BRANCH_DATABASE_CAP=20
# Most databases a branch serves through the data API, the main database included (orchestrator
# only; default 10, allowed 1..=100). Over it, enabling a database answers 409.
# CHELABASE_BRANCH_DATA_API_DATABASE_CAP=10
# Password strength for passwords set in SQL: "on" or "off" (default "off" in self-hosted
# mode; platform mode always checks).
# CHELABASE_PASSWORD_STRENGTH=off

# --- Service credentials (generated; never in this file or stack.env) ---
# chelabase-init (init-secrets; `just workbench up` in a workbench) creates each one once
# (never overwritten, 0600 or 0640 with its reader's group) and only the services that read it
# mount it, getting its path as <NAME>_FILE:
#   nats/<user>.password      NATS users orchestrator, worker, realtime, runner (no anonymous access)
#   valkey/<user>.password    Valkey ACL users proxy, control, realtime, runner, health
#   tokens/*.token            the internal bearers: CHELABASE_REST_INTERNAL_TOKEN,
#                             CHELABASE_DATA_KEYS_TOKEN, CHELABASE_APP_AUTH_INTERNAL_TOKEN,
#                             CHELABASE_APP_SESSIONS_INTERNAL_TOKEN, CHELABASE_STORAGE_INTERNAL_TOKEN,
#                             CHELABASE_PROXY_API_TOKEN, CHELABASE_STORCON_HOOK_TOKEN
#   realtime/*                realtime's Postgres password, ticket key and internal bearer
#   neon/storage-tokens/*.jwt the storage services' NeonJWTs, signed with the compute-JWT key pair
#   db/*, s3/*                the databases' passwords and the object store's keys (a
#                             workbench keeps its fixed dev values)
# A service run apart from a stack reads <NAME> or <NAME>_FILE; unset, a bearer falls back to
# a public development value, which every service refuses unless CHELABASE_DEV_DEFAULTS=1.

# --- Neon storage and proxy ---
# The pageserver, the three safekeepers and the storage controller require NeonJWT (no --dev).
# STORCON_URL=http://127.0.0.1:1234
# CHELABASE_STORCON_URL=http://127.0.0.1:1234
# Safekeeper HTTP API by storage-controller id (`id=url`, comma separated); the worker reads
# each timeline's commit LSN from here. Default: one safekeeper on 127.0.0.1:7676.
# CHELABASE_SAFEKEEPER_HTTP=1=http://127.0.0.1:7676
# Where Neon (the pageserver and the safekeepers) reaches S3 for its layers and WAL: Compose
# substitutes it into their commands (no service reads it from its environment); the storage
# service has its own endpoint setting. Default: the compose SeaweedFS.
# CHELABASE_NEON_S3_ENDPOINT=http://seaweedfs:8333

# --- Object storage ---
# The storage service (behind the gateway at /storage/v1): files in buckets, in SeaweedFS's
# bucket chelabase-storage, under the `storage` identity. Blank = the service's default.
# Connections it opens to computes, across every branch (default 200).
# CHELABASE_STORAGE_MAX_CONNECTIONS=200
# Upload buffers it holds at once, bytes (default 1073741824, 1 GiB); past it, 503 `busy`.
# CHELABASE_STORAGE_MAX_INFLIGHT_BYTES=1073741824
# An upload whose body sends nothing for this long fails with 408, seconds (default 60, at least 1).
# CHELABASE_STORAGE_BODY_IDLE_SECS=60
# The worker's sweep of blobs nothing references any more: how long a blob is kept after its
# last reference goes, seconds (default and least 691200, 8 days: past the longest signed URL
# and the databases' history), how often it runs, seconds (default 21600, 6 hours; 60..=604800),
# and true to only log what it would delete.
# CHELABASE_STORAGE_SWEEP_GRACE_SECS=691200
# CHELABASE_STORAGE_SWEEP_SECS=21600
# CHELABASE_STORAGE_SWEEP_DRY_RUN=false
# Storage webhooks (the orchestrator checks a URL when it is registered, the worker again on
# every delivery): https only and public addresses only, unless allowed here. Host names or IP
# literals, comma separated, without a port, that may resolve to private addresses (a receiver
# on this machine or your network); blank: none. true also accepts http URLs (local receivers).
# CHELABASE_WEBHOOKS_ALLOW_HOSTS=
# CHELABASE_WEBHOOKS_ALLOW_HTTP=false

# --- Edge functions ---
# The functions service (behind the gateway at /functions/v1) and its runtime run by default.
# Blank = the service's default.
# An invocation's wall clock, milliseconds (default 30000): past it, 504 `function_timeout`.
# CHELABASE_FUNCTIONS_TIMEOUT_MS=30000
# Invocations of one function on one branch running at once (default 32): one more answers
# 429 `too_many_requests` at once instead of queueing in the shared runtime.
# CHELABASE_FUNCTIONS_MAX_CONCURRENT=32
# The runtime container's memory limit (a compose size, default 1g); every function shares it.
# CHELABASE_FUNCTIONS_RUNTIME_MEMORY=1g
# External services (functions' outbound service bindings): https to public addresses only,
# unless allowed here. Host names or IP literals, comma separated, without a port, that may
# resolve to private addresses; blank: none. true also accepts http URLs. Both the orchestrator
# (when a service is saved) and the functions service (every connection) read them.
# CHELABASE_SERVICES_ALLOW_HOSTS=
# CHELABASE_SERVICES_ALLOW_HTTP=false
# Container services (m10): the service runner runs only with `COMPOSE_PROFILES=services`
# (off by default; without it container services answer 503). It is the one service besides the
# orchestrator and the worker that mounts the Docker socket, and it only acts on its own
# labelled containers. Each container gets at most this much memory (MiB, default 512) and CPU
# (default 1); a service's spec may ask for less, never more. It reconciles every running
# service with its desired state this often (seconds, default 30).
# CHELABASE_SERVICE_RUNNER_MEMORY_CAP_MB=512
# CHELABASE_SERVICE_RUNNER_CPU_CAP=1
# CHELABASE_SERVICE_RUNNER_RECONCILE_SECS=30

# --- MCP ---
# The MCP server (behind the gateway at /mcp, for signed-in members) and its sandbox runtime run
# only with `COMPOSE_PROFILES=mcp` (off by default). With the profile, point the gateway at the
# server too; blank: the gateway answers 404 on /mcp.
# CHELABASE_MCP_URL=http://mcp-public:8095
# Blank = the service's default.
# Allow-list of origins, comma separated, for clients that send an Origin header (default: none,
# so such a request is refused with 403; clients that send none are unaffected). Browsers can't
# call /mcp directly today: the route has no CORS.
# CHELABASE_MCP_ALLOWED_ORIGINS=
# 1 writes every tool call's code to the audit log (default 0).
# CHELABASE_MCP_LOG_CODE=0
# A tool call's wall clock, milliseconds (default 30000).
# CHELABASE_MCP_TIMEOUT_MS=30000
# The largest tool result, bytes of JSON text (default 24000); a longer one is cut with a marker.
# CHELABASE_MCP_RESULT_MAX_BYTES=24000
# Tool calls a member may make a minute (default 60), runs a member may have in flight (default
# 2) and runs in flight overall (default 8).
# CHELABASE_MCP_CALLS_PER_MINUTE=60
# CHELABASE_MCP_MEMBER_CONCURRENCY=2
# CHELABASE_MCP_CONCURRENCY=8
# API calls one execute run may make (1 to 1000, default 50).
# CHELABASE_MCP_MAX_CALLS=50
# The largest API response execute reads, bytes (1024 to 8388608, default 1048576); a larger one
# answers response_too_large, as does an answer whose JSON form is over 8 MiB.
# CHELABASE_MCP_RESPONSE_MAX_BYTES=1048576
# The runtime container's memory limit, with no swap (a compose size, default 512m); every run
# shares it.
# CHELABASE_MCP_RUNTIME_MEMORY=512m

# --- App users (docs site, /using/app-users) ---
# Access token lifetime, seconds (auth; 60..=86400)
# CHELABASE_APP_ACCESS_TTL_SECS=900
# Member access token lifetime, seconds (auth; 60..=900)
# CHELABASE_MEMBER_ACCESS_TTL_SECS=300
# How long the orchestrator reuses identity's answer that a member token's session is still
# live, seconds (0..=30; 0 asks every time). A token stops working this long after logout or
# a password reset at most.
# CHELABASE_MEMBER_SESSION_CHECK_SECS=15
# Refresh token sliding lifetime, seconds (orchestrator; at most 90 days)
# CHELABASE_APP_REFRESH_TTL_SECS=2592000
# How often the worker reconciles each enabled project's users, seconds (30..=86400)
# CHELABASE_APP_USERS_RECONCILE_SECS=300
# How often the worker reconciles every branch's member roles, seconds (30..=86400): the
# backstop for reconcile requests lost on NATS or whose retries all failed
# CHELABASE_MEMBER_ROLES_SWEEP_SECS=300
# Platform mode only (a self-hosted install doesn't pass it): the tenant whose active members
# administer the instance (/v1/instance/settings); nobody passes while it is unset.
# CHELABASE_OPERATOR_TENANT_ID=
# Worker reconcile removes compute containers with no endpoint row; false logs and keeps them.
# The worker only lists computes labelled with its own stack (CHELABASE_STACK: the Compose
# project in a self-hosted install), so this switch is not what keeps stacks apart.
# CHELABASE_WORKER_REMOVE_ORPHANS=true
